# ---------------------------------------------------------------------------
# Najem Clean Service — variables d'environnement
# Copier ce fichier en `.env.local` puis renseigner les valeurs réelles.
# Ne jamais committer de secret.
# ---------------------------------------------------------------------------

# URL canonique du site (sans slash final). Utilisée par les metadata, le
# sitemap, les URLs canoniques et les données structurées.
# À RENSEIGNER avant la mise en ligne : tant que la variable est vide, le code
# retombe sur un domaine d'exemple qui n'a pas été confirmé.
NEXT_PUBLIC_SITE_URL=

# --- Analytics (optionnel) -------------------------------------------------
# Laisser vide tant qu'aucun outil de mesure n'est réellement installé :
# aucun script n'est injecté si la variable est absente.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=

# Code de vérification Google Search Console (balise meta).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# --- Formulaire de contact -------------------------------------------------
# Adresse qui reçoit les messages du formulaire (côté serveur uniquement).
CONTACT_INBOX_EMAIL=

# Fournisseur d'envoi d'e-mails (ex. Resend). Ces trois variables sont
# nécessaires pour que le formulaire aboutisse : sans elles, l'envoi est
# refusé et un message d'erreur s'affiche, plutôt qu'une fausse confirmation.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=

# --- Supabase (contenu modifiable depuis /admin) ---------------------------
# Les valeurs se trouvent dans Supabase > Project Settings > API.
# Exécuter une fois /supabase/schema.sql dans le SQL Editor du projet.
#
# Tant que ces variables sont vides, le site affiche les textes écrits dans le
# code : rien ne casse, mais l'administration ne peut rien enregistrer.

# URL du projet, par exemple https://xxxxxxxx.supabase.co
SUPABASE_URL=

# Clé publique (« anon » / « publishable »). Lecture seule grâce aux
# politiques RLS. Elle n'est jamais envoyée au navigateur ici.
SUPABASE_ANON_KEY=

# Clé secrète (« service_role »). Elle contourne les politiques RLS : elle ne
# doit JAMAIS être préfixée par NEXT_PUBLIC_, ni committée, ni partagée.
SUPABASE_SERVICE_ROLE_KEY=

# --- Administration du site ------------------------------------------------
# L'accès à /admin repose entièrement sur Supabase Auth : il n'y a aucun mot
# de passe dans le code ni dans les variables d'environnement.
#
# Pour habiliter quelqu'un :
#   1. Supabase > Authentication > Users > Add user (adresse + mot de passe) ;
#   2. ajouter la même adresse ci-dessous, séparée par une virgule.
#
# Les deux sont nécessaires. Avoir un compte Supabase ne suffit donc pas :
# c'est une sécurité volontairement redondante avec la désactivation des
# inscriptions publiques, dans Supabase > Authentication > Sign In / Providers
# > Email > Allow new users to sign up.
#
# Liste vide = personne ne peut entrer. En cas d'oubli, l'administration se
# ferme au lieu de s'ouvrir.
ADMIN_EMAILS=

# --- Divers ----------------------------------------------------------------
# Passer à "true" pour autoriser l'indexation d'un environnement de
# préproduction (par défaut, seule la production est indexable).
NEXT_PUBLIC_ALLOW_INDEXING=
